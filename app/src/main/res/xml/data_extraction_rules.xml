<?xml version="1.0" encoding="utf-8"?>
<!-- The shop database is encrypted with a key that never leaves this phone, so system backups would be unreadable.
     The app makes its own backups instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
