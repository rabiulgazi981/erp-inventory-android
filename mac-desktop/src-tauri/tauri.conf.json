{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ERP Inventory",
  "version": "1.0.0",
  "identifier": "com.bongshaltech.erpinventory.mac",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "publisher": "Bongshal Tech",
    "copyright": "© Bongshal Tech",
    "category": "Business",
    "shortDescription": "ERP Inventory – POS & Stock",
    "homepage": "https://erpinventory.bd",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.3",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 540,
          "height": 380
        },
        "appPosition": {
          "x": 140,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 400,
          "y": 190
        }
      }
    }
  }
}
