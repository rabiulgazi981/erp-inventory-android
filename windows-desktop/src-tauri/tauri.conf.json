{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ERP Inventory",
  "version": "1.0.0",
  "identifier": "com.bongshaltech.erpinventory.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Bongshal Tech",
    "copyright": "© Bongshal Tech",
    "category": "Business",
    "shortDescription": "ERP Inventory – POS & Stock",
    "homepage": "https://erpinventory.bd",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
